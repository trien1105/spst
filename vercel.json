{
  "buildCommand": "node generate-assets.js && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/race/:path*",
      "destination": "http://180.93.126.40:4000/api/race/:path*"
    },
    {
      "source": "/health",
      "destination": "http://180.93.126.40:4000/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
